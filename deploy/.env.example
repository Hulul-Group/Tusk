# Copy to deploy/.env and edit. Used by deploy/docker-compose.scale.yml.
DEFAULT_DOMAIN=s.example.com
SITE_NAME=Kutt
# MUST equal the old Kutt JWT_SECRET so existing sessions/cookies stay valid.
JWT_SECRET=change-me-to-a-long-random-string
DB_NAME=kutt
DB_USER=kutt
DB_PASSWORD=change-me
ACME_EMAIL=ops@example.com
# Cloudflare API token with Zone:DNS:Edit on the zone (for the DNS-01 origin certificate).
CF_DNS_API_TOKEN=
# Cloudflare edge ranges (https://www.cloudflare.com/ips-v4 + ips-v6), comma separated.
CLOUDFLARE_IPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
# cf-only@docker when custom domains are proxied by Cloudflare (Cloudflare for SaaS),
# none@docker when customers point DNS-only records straight at the origin.
CUSTOM_DOMAIN_MIDDLEWARES=cf-only@docker
GEO_PROVIDER=cloudflare
REDIRECTOR_REPLICAS=2
API_REPLICAS=2
WORKER_REPLICAS=1
# Optional: SMTP, OIDC, REPORT_EMAIL, … — any Kutt variable works here.
# MAIL_ENABLED=true
# MAIL_HOST=smtp.example.com
