# Tusk configuration. Copy to .env and edit.
# Every Kutt v3.2.6 variable keeps its name, type and default, so an existing
# Kutt .env works unchanged. Any variable also accepts NAME_FILE=/path (Docker secrets).
# Source of truth: internal/config/config.go

# ---------- App ----------
PORT=3000
SITE_NAME=Kutt
# Short-link domain (no scheme). Must match the Host header the proxy forwards.
DEFAULT_DOMAIN=localhost:3000
LINK_LENGTH=6
LINK_CUSTOM_ALPHABET=abcdefghkmnpqrstuvwxyzABCDEFGHKLMNPQRSTUVWXYZ23456789
# Behind Traefik/Cloudflare keep true (client IP from X-Forwarded-For).
TRUST_PROXY=true
# production enables Secure cookies and requires JWT_SECRET (TUSK_ENV=production also works).
NODE_ENV=production
# REQUIRED in production. Use the SAME value as your Kutt install so existing logins stay valid.
JWT_SECRET=

# ---------- Database ----------
# pg | pg-native | mysql | mysql2 | sqlite3 | better-sqlite3
DB_CLIENT=better-sqlite3
# sqlite only
DB_FILENAME=db/data
# pg / mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kutt
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10

# ---------- Redis ----------
# Required when SERVICE_ROLES is not "all" (cross-service events + cache invalidation).
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Access ----------
DISALLOW_ANONYMOUS_LINKS=true
DISALLOW_REGISTRATION=true
DISALLOW_LOGIN_FORM=false

# ---------- Custom domains ----------
# Shown to users as DNS instructions when adding a custom domain.
SERVER_IP_ADDRESS=
SERVER_CNAME_ADDRESS=
CUSTOM_DOMAIN_USE_HTTPS=false

# ---------- Mail ----------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_FROM=
MAIL_PASSWORD=

# ---------- OIDC ----------
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_PROMPT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_EMAIL_CLAIM=email
OIDC_BUTTON_TEXT=Log in with OIDC

# ---------- Misc ----------
ENABLE_RATE_LIMIT=false
REPORT_EMAIL=
CONTACT_EMAIL=

# ======================= Tusk additions =======================

# ---------- Geo (visitor country for stats) ----------
# auto       CDN header if present and trusted, else GeoIP file if set, else "unknown"
# cloudflare only the header below (enable Network > IP Geolocation in the Cloudflare zone)
# geoip      only a local .mmdb file (MaxMind GeoLite2-Country or DB-IP lite)
# none       disabled; every visit stored as "unknown"
GEO_PROVIDER=auto
GEO_HEADER=CF-IPCountry
GEOIP_DB_PATH=
# Honour CF-IPCountry / CF-Connecting-IP only when the request comes from Cloudflare's IP ranges.
# Set false only if the origin is unreachable except through your CDN.
GEO_TRUST_CLOUDFLARE_ONLY=true
CLOUDFLARE_IP_RANGES_URLS=https://www.cloudflare.com/ips-v4,https://www.cloudflare.com/ips-v6

# ---------- Services ----------
# all = single process (drop-in for Kutt). Split: api | redirector | worker (comma list).
SERVICE_ROLES=all
REDIRECTOR_PORT=3001
# Prometheus /metrics listener; 0 disables.
METRICS_PORT=9090

# ---------- Redirect cache ----------
LOCAL_CACHE_SIZE=100000
# Max staleness on other nodes if an invalidation message is missed.
LOCAL_CACHE_TTL=30s
REDIS_CACHE_TTL=15m

# ---------- Visit pipeline ----------
VISIT_BATCH_SIZE=500
VISIT_FLUSH_INTERVAL=1s
VISIT_BUFFER_SIZE=100000
EXPIRED_LINK_SWEEP=30s

# ---------- Theming ----------
# Files here override the built-in UI assets (css/, images/), like Kutt's custom/ folder.
TUSK_CUSTOM_DIR=custom
